{
  "header": {
    "description": "Chatter Repository Configuration - Development defaults (user configs are in ~/Documents/Chatter)",
    "version": "2.0.0",
    "last_updated": "2025-11-11",
    "schema_notes": "This file is used as a fallback during development. Production configs are managed by preflight in user's Chatter directory."
  },

  "global": {
    "general": {
      "output_directory": "./output",
      "temp_directory": "./temp",
      "log_level": "INFO"
    },

    "contacts": {
      "vcf_file_path": "",
      "phone_region": "US",
      "enable_contact_resolution": true,
      "normalize_phone_numbers": true
    },

    "performance": {
      "max_workers": 4,
      "batch_size": 1000,
      "enable_parallel_processing": true,
      "memory_limit_mb": null
    },

    "ai_translation": {
      "enabled": false,
      "provider": "openrouter",
      "api_key_env_var": "OPENROUTER_API_KEY",
      "model": "anthropic/claude-3-haiku",
      "max_requests_per_minute": 60,
      "timeout_seconds": 30,
      "fallback_on_error": true
    },

    "database": {
      "unified_schema": {
        "enabled": false,
        "file": "output/chat_archive.db",
        "version": "1.0"
      },
      "per_service_exports": {
        "enabled": true,
        "format": "json",
        "separate_files": true
      }
    }
  }
}
